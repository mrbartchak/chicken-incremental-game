; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="chicken-incremental-game"
config/version="0.1.0"
run/main_scene="uid://73d71fc5ulh"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60

[audio]

buses/default_bus_layout="res://core/audio/default_bus_layout.tres"

[autoload]

GameManager="*res://core/autoloads/game_manager.gd"
GameEffects="*res://core/autoloads/game_effects.gd"
Version="*res://core/autoloads/version.gd"
AudioManager="*res://core/autoloads/audio_manager.gd"
SaveManager="*res://core/autoloads/save_manager.gd"
Cursor="*res://ui/cursor/cursor.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=2
window/size/window_width_override=1440
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[global_group]

interactive_ui=""

[gui]

common/snap_controls_to_pixels=false
theme/custom_font="uid://dc64gsq8ochws"

[input]

click={
"deadzone": 0.2,
"events": []
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
